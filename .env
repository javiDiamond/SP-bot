# Wallex Grid Bot - Environment Variables

# Node.js Environment
NODE_ENV=development

# API Server
PORT=4000
HOST=0.0.0.0

# Database
DATABASE_URL=postgresql://wallex:wallex_password@postgres:5432/wallex_grid_bot

# Redis
REDIS_URL=redis://redis:6379

# Security
JWT_SECRET=super-secret-jwt-key-for-development-only-change-in-production
ENCRYPTION_KEY=12345678901234567890123456789012

# Wallex Exchange
WALLEX_API_BASE_URL=https://api.wallex.ir
WALLEX_WS_URL=wss://api.wallex.ir/ws
WALLEX_API_KEY_HEADER=API-Key

# Trading Configuration
ENABLE_LIVE_TRADING=false
DEFAULT_TRADING_MODE=DRY_RUN

# Rate Limits
STALE_PRICE_TIMEOUT_SECONDS=30
REST_POLL_INTERVAL_MS=5000
ORDER_RATE_LIMIT_PER_10S=20

# CORS
CORS_ORIGIN=*

# Logging
LOG_LEVEL=info
