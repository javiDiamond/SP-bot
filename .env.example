# Wallex Grid Bot - Environment Variables
# Copy to .env and adjust. Never commit real API keys or secrets.

# Node.js Environment
NODE_ENV=development

# API Server
PORT=4000
HOST=0.0.0.0

# Database
DATABASE_URL=postgresql://wallex:wallex_password@localhost:5432/wallex_grid_bot

# Redis
REDIS_URL=redis://localhost:6379

# Security (generate with: openssl rand -hex 32)
JWT_SECRET=change-me-to-secure-random-string-at-least-32-chars
ENCRYPTION_KEY=0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef

# Wallex API Configuration
WALLEX_API_BASE_URL=https://api.wallex.ir
WALLEX_WS_URL=wss://api.wallex.ir/ws
WALLEX_API_KEY_HEADER=API-Key

# Optional: Private WebSocket Stream Key (from Wallex login; if absent, REST polling is used)
# WALLEX_STREAM_KEY=your-manual-stream-key-from-wallex-login

# Trading Configuration (ENABLE_LIVE_TRADING must be explicitly true for live orders)
ENABLE_LIVE_TRADING=false
DEFAULT_TRADING_MODE=DRY_RUN

# Demo synthetic market data for offline dry-run (true = random-walk ticks when WS/REST unavailable)
DEMO_MARKET_DATA=false

# Market Data
STALE_PRICE_TIMEOUT_SECONDS=30
REST_POLL_INTERVAL_MS=5000

# Rate Limiting
ORDER_RATE_LIMIT_PER_10S=20

# Optional: Minimum Notional Fallback (in quote asset)
MIN_NOTIONAL_FALLBACK=1

# Optional: Sub-account Client ID (for credit account trading)
# SUB_ACCOUNT_CLIENT_ID=your-sub-account-client-id

# Admin User (for initial seed)
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=change-me

# CORS / Logging
CORS_ORIGIN=*
LOG_LEVEL=info

# Web (Next.js)
WEB_PORT=3000
NEXT_PUBLIC_API_URL=http://localhost:4000

# Docker service ports
API_PORT=4000
