# Wallex Grid Bot - Environment Variables
# Copy to .env and adjust. Never commit real API keys or secrets.

# Node.js Environment
NODE_ENV=development

# API Server
PORT=4000
HOST=0.0.0.0

# Database
DATABASE_URL=postgresql://wallex:wallex_password@localhost:5432/wallex_grid_bot

# Redis
REDIS_URL=redis://localhost:6379

# Security (generate with: openssl rand -base64 32 / openssl rand -hex 32)
JWT_SECRET=change-me-to-secure-random-string-at-least-32-chars
# Must be 64 hex chars (32 bytes) for AES-256-GCM
ENCRYPTION_KEY=0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef

# Wallex API Configuration
WALLEX_API_BASE_URL=https://api.wallex.ir
WALLEX_WS_URL=wss://api.wallex.ir/ws
WALLEX_API_KEY_HEADER=API-Key

# Trading Configuration (live trading requires ALL of: this flag, RiskSetting.allowLiveTrading in DB, account.isLiveEnabled)
ENABLE_LIVE_TRADING=false
DEFAULT_TRADING_MODE=DRY_RUN

# Market Data
STALE_PRICE_TIMEOUT_SECONDS=30
REST_POLL_INTERVAL_MS=5000

# Rate Limiting
ORDER_RATE_LIMIT_PER_10S=20

# CORS — restrict to the dashboard origin (default Next.js port). Use a
# comma-separated list for multiple origins in production.
CORS_ORIGIN=http://localhost:3000

# Logging
LOG_LEVEL=info

# Admin User (for initial seed)
ADMIN_EMAIL=admin@wallex-grid.local
ADMIN_PASSWORD=admin123

# Optional: Private WebSocket stream key (from Wallex login) for private channels
# WALLEX_STREAM_KEY=your-manual-stream-key-from-wallex-login

# Optional: Sub-account client id (credit account trading)
# SUB_ACCOUNT_CLIENT_ID=your-sub-account-client-id

# Optional: Minimum notional fallback in quote currency
MIN_NOTIONAL_FALLBACK=1
