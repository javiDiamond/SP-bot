FROM node:20-alpine AS base

WORKDIR /app

# Install pnpm
RUN corepack enable pnpm

# Optional: bake a fixed API base URL into the client bundle. Leave unset so
# the dashboard uses same-origin /api paths, proxied to API_PROXY_TARGET by
# Next.js rewrites (required for Codespaces / tunnel port forwarding).
ARG NEXT_PUBLIC_API_URL
ENV NEXT_PUBLIC_API_URL=${NEXT_PUBLIC_API_URL}

# Same-origin /api rewrite target, resolved at build time (Next.js persists
# rewrites at build). Inside compose this reaches the API service by name.
ARG API_PROXY_TARGET=http://api:4000
ENV API_PROXY_TARGET=${API_PROXY_TARGET}

# Copy workspace manifests (all of them so pnpm can resolve the workspace graph)
COPY package.json pnpm-lock.yaml* pnpm-workspace.yaml* turbo.json tsconfig.base.json ./
COPY apps/api/package.json ./apps/api/
COPY apps/web/package.json ./apps/web/
COPY apps/worker/package.json ./apps/worker/
COPY packages/shared/package.json ./packages/shared/
COPY packages/exchange/package.json ./packages/exchange/
COPY packages/grid-strategy/package.json ./packages/grid-strategy/
COPY packages/backtester/package.json ./packages/backtester/
COPY packages/db/package.json ./packages/db/

# Install dependencies
RUN pnpm install --frozen-lockfile || pnpm install

# Copy the source needed to build the web app (and its workspace deps)
COPY apps/web ./apps/web
COPY packages/shared ./packages/shared
# Prisma schema is required by the workspace build's db:generate step
COPY packages/db/prisma ./packages/db/prisma

# Build the dashboard and its workspace dependencies
RUN pnpm build --filter=@wallex-grid/web...

# Production image
FROM node:20-alpine AS runner

WORKDIR /app

ENV NODE_ENV=production

RUN addgroup --system --gid 1001 nodejs
RUN adduser --system --uid 1001 nextjs

COPY --from=base /app/apps/web/.next/standalone ./
COPY --from=base /app/apps/web/.next/static ./apps/web/.next/static
COPY --from=base /app/apps/web/public ./apps/web/public

USER nextjs

EXPOSE 3000

CMD ["node", "apps/web/server.js"]
